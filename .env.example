# ============================================================
# Admin panel (/admin) — environment variables
# ============================================================
# Copy to `.env.local` for local dev (gitignored). In production set the
# same variables in Vercel → Settings → Environment Variables.
# Full setup guide: ADMIN.md

# ---- Auth.js session secret --------------------------------
# Random 32-byte secret used to sign the session cookie.
# Generate once with:  openssl rand -base64 32
# Optional locally (a dev fallback is built in), REQUIRED in production.
AUTH_SECRET=""

# ---- Login without a database (simplest setup) --------------
# When DATABASE_URL is empty the admin has a single owner account taken
# from these two variables. Enough for one editor.
ADMIN_USERNAME="owner"
ADMIN_PASSWORD="change-me"

# ---- User database (optional, for several editors) ----------
# Neon / Vercel Postgres connection string. When set, accounts live in the
# DB: invites, password change, up to 5 editors.
#   npm run db:setup   → creates tables
#   npm run db:seed    → creates the owner from SEED_USERNAME / SEED_PASSWORD
DATABASE_URL=""
SEED_USERNAME="owner"
SEED_PASSWORD="change-me"

# ---- Content writes (GitHub API) ---------------------------
# Locally (empty GITHUB_TOKEN) the admin writes straight into src/content
# and public/images/uploads — the dev server shows edits instantly.
#
# In production the filesystem is read-only, so every save becomes a commit
# to this repo and Vercel rebuilds the site (~2-3 min). Create a
# fine-grained personal access token at
#   https://github.com/settings/tokens?type=beta
# with access to ONLY this repo and permission Contents: Read and write.
GITHUB_TOKEN=""
GITHUB_REPO="Bankai-Agency/GOAT_moving"
GITHUB_BRANCH="main"
